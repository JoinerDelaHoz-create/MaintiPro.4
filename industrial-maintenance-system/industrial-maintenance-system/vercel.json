{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/tecnico",
      "destination": "/tecnico.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
